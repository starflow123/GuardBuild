{
  "version": 1,
  "_note": "黑盒精度基准语料：每个靶场标注「期望退出码 + 期望 vulnerable 用例 + 禁止出现的用例族」。带 * 的规则按前缀匹配；forbidden 优先于 expected，避免 blackbox-idor-* 把写/删变体一起放过。",
  "targets": [
    {
      "id": "legacy-shop",
      "fixture": "fixtures/legacy-shop",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-idor-api-orders-5002"]
    },
    {
      "id": "legacy-shop-fixed",
      "fixture": "fixtures/legacy-shop",
      "_note": "与 e2e:blackbox 的 fixed 变体同源：只在订单详情路由补归属校验。",
      "patches": [
        {
          "file": "src/app.js",
          "search": "const order = findOrderById(orderId);",
          "insertAfter": "\n    if (order && order.userId !== auth.user.id) return json(res, 403, { error: \"无权访问该订单\" });"
        }
      ],
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "wide-shop",
      "fixture": "fixtures/wide-shop",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": [
        "blackbox-vertical-*",
        "blackbox-idor-*",
        "blackbox-sqli-numeric-*",
        "blackbox-traversal-*",
        "blackbox-cors-*",
        "blackbox-xss-*"
      ],
      "forbiddenVulnerable": [
        "blackbox-idor-put-*",
        "blackbox-idor-patch-*",
        "blackbox-idor-delete-*",
        "blackbox-anon-write-*",
        "blackbox-csrf-*"
      ]
    },
    {
      "id": "wide-shop-mutate",
      "fixture": "fixtures/wide-shop",
      "_note": "allowMutation：写与匿名写应出现，DELETE 仍禁止。",
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1" },
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": [
        "blackbox-vertical-*",
        "blackbox-idor-*",
        "blackbox-sqli-numeric-*",
        "blackbox-traversal-*",
        "blackbox-cors-*",
        "blackbox-xss-*",
        "blackbox-idor-put-*",
        "blackbox-idor-patch-*",
        "blackbox-anon-write-*"
      ],
      "forbiddenVulnerable": ["blackbox-idor-delete-*", "blackbox-csrf-*"]
    },
    {
      "id": "wide-shop-destructive",
      "fixture": "fixtures/wide-shop",
      "_note": "allowDestructive：DELETE 才允许出现。",
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1", "GUARDBUILD_BLACKBOX_DELETE": "1" },
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": [
        "blackbox-vertical-*",
        "blackbox-idor-*",
        "blackbox-sqli-numeric-*",
        "blackbox-traversal-*",
        "blackbox-cors-*",
        "blackbox-xss-*",
        "blackbox-idor-put-*",
        "blackbox-idor-patch-*",
        "blackbox-idor-delete-*",
        "blackbox-anon-write-*"
      ],
      "forbiddenVulnerable": ["blackbox-csrf-*"]
    },
    {
      "id": "wide-shop-hardened",
      "fixture": "fixtures/wide-shop",
      "serverEnv": { "GB_WIDE_HARDENED": "1" },
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1", "GUARDBUILD_BLACKBOX_DELETE": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "wide-shop-cookie",
      "fixture": "fixtures/wide-shop",
      "_note": "Cookie 会话 + allowMutation：CSRF 只在这种鉴权形态下有意义。",
      "configReplace": {
        "login": {
          "path": "/session/login",
          "bodyTemplate": { "email": "{email}", "password": "{password}" },
          "cookieAuth": true,
          "encoding": "form"
        }
      },
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1" },
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": [
        "blackbox-vertical-*",
        "blackbox-idor-*",
        "blackbox-sqli-numeric-*",
        "blackbox-traversal-*",
        "blackbox-cors-*",
        "blackbox-xss-*",
        "blackbox-idor-put-*",
        "blackbox-idor-patch-*",
        "blackbox-anon-write-*",
        "blackbox-csrf-*"
      ],
      "forbiddenVulnerable": ["blackbox-idor-delete-*"]
    },
    {
      "id": "wide-shop-cookie-hardened",
      "fixture": "fixtures/wide-shop",
      "configReplace": {
        "login": {
          "path": "/session/login",
          "bodyTemplate": { "email": "{email}", "password": "{password}" },
          "cookieAuth": true,
          "encoding": "form"
        }
      },
      "serverEnv": { "GB_WIDE_HARDENED": "1" },
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1", "GUARDBUILD_BLACKBOX_DELETE": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "spa-shop",
      "fixture": "fixtures/spa-shop",
      "_note": "无 OpenAPI、路径不在词表，/api/v2/orders 只出现在动态 import 的二级 chunk：靠前端模块图发现。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-idor-api-v2-orders-5002"]
    },
    {
      "id": "seo-shop",
      "fixture": "fixtures/seo-shop",
      "_note": "无 OpenAPI、路径不在词表：/api/accounts/export 只在 robots.txt 的 Disallow 里，/api/invoices/archive 只在 sitemap.xml 的 <loc> 里。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-unauth-api-accounts-export", "blackbox-unauth-api-invoices-archive"]
    },
    {
      "id": "seo-shop-hardened",
      "fixture": "fixtures/seo-shop",
      "_note": "同一份 robots/sitemap 声明，两端点改为需登录：声明本身不是漏洞判据。",
      "serverEnv": { "GB_SEO_HARDENED": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "nextbuild-shop",
      "fixture": "fixtures/nextbuild-shop",
      "_note": "接口字面量只在 _buildManifest.js 列出的二级 chunk 里；入口 chunk 只有 __NEXT_DATA__，不做清单遍历必然漏报。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-unauth-api-accounts-ledger"]
    },
    {
      "id": "nextbuild-shop-hardened",
      "fixture": "fixtures/nextbuild-shop",
      "serverEnv": { "GB_NEXT_HARDENED": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "swaggerui-shop",
      "fixture": "fixtures/swaggerui-shop",
      "_note": "常规 JSON 文档路径全 404，规格地址只写在 /swagger-ui.html 的 url 字段里；拿到规格才有 year 参数声明。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-sqli-numeric-api-invoices-year"]
    },
    {
      "id": "swaggerui-shop-hardened",
      "fixture": "fixtures/swaggerui-shop",
      "serverEnv": { "GB_SWAGGER_HARDENED": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "ssrf-shop",
      "fixture": "fixtures/ssrf-shop",
      "_note": "GET /api/preview?url=… 把参数交给 fetch；黑盒把 URL 指向本机 canary，只有真实回连才判漏洞。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-ssrf-*"],
      "forbiddenVulnerable": ["blackbox-upload-*", "blackbox-jwt-*", "blackbox-biz-*"]
    },
    {
      "id": "ssrf-shop-hardened",
      "fixture": "fixtures/ssrf-shop",
      "serverEnv": { "GB_SSRF_HARDENED": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "upload-shop",
      "fixture": "fixtures/upload-shop",
      "_note": "allowMutation 下上传仅含随机令牌的 HTML，并要求同源回读命中令牌 + 主动类型。",
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1" },
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-upload-*"],
      "forbiddenVulnerable": ["blackbox-ssrf-*", "blackbox-jwt-*", "blackbox-biz-*"]
    },
    {
      "id": "upload-shop-default",
      "fixture": "fixtures/upload-shop",
      "_note": "同一漏洞目标，但未开 allowMutation：上传探测族必须整族沉默（默认零副作用口径）。",
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": [],
      "forbiddenVulnerable": ["blackbox-upload-*", "blackbox-biz-*"]
    },
    {
      "id": "upload-shop-hardened",
      "fixture": "fixtures/upload-shop",
      "serverEnv": { "GB_UPLOAD_HARDENED": "1" },
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "jwt-shop",
      "fixture": "fixtures/jwt-shop",
      "_note": "受保护端点只 decode 不验签：alg=none / 无效签名令牌被接受且回显伪造身份才判。",
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-jwt-*"],
      "forbiddenVulnerable": ["blackbox-ssrf-*", "blackbox-upload-*", "blackbox-biz-*"]
    },
    {
      "id": "jwt-shop-hardened",
      "fixture": "fixtures/jwt-shop",
      "serverEnv": { "GB_JWT_HARDENED": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    },
    {
      "id": "bizlogic-shop",
      "fixture": "fixtures/bizlogic-shop",
      "_note": "状态跳步 + 并发双花都会真实修改业务状态，仅在 allowMutation + allowDestructive 下执行。",
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1", "GUARDBUILD_BLACKBOX_DELETE": "1" },
      "expectedExit": 1,
      "expectedOutcomes": ["vulnerable_unfixed"],
      "expectedVulnerable": ["blackbox-biz-state-*", "blackbox-biz-race-*"],
      "forbiddenVulnerable": ["blackbox-ssrf-*", "blackbox-upload-*", "blackbox-jwt-*"]
    },
    {
      "id": "bizlogic-shop-default",
      "fixture": "fixtures/bizlogic-shop",
      "_note": "同一漏洞目标，但未开 allowMutation/allowDestructive：状态跳步与并发双花必须整族沉默（会真实改业务状态与资金）。",
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": [],
      "forbiddenVulnerable": ["blackbox-biz-*", "blackbox-upload-*"]
    },
    {
      "id": "bizlogic-shop-hardened",
      "fixture": "fixtures/bizlogic-shop",
      "serverEnv": { "GB_BIZ_HARDENED": "1" },
      "env": { "GUARDBUILD_BLACKBOX_MUTATE": "1", "GUARDBUILD_BLACKBOX_DELETE": "1" },
      "expectedExit": 0,
      "expectedOutcomes": ["no_findings"],
      "expectedVulnerable": []
    }
  ]
}
