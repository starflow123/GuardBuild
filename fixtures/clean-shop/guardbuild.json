{
  "_note": "精度基准对照靶场：所有对象级接口都做了归属校验，gate 期望 exit 0（not_reproducible）。",
  "start": {
    "cmd": "node",
    "args": ["server.js"],
    "env": { "PORT": "0" },
    "readyPattern": "已就绪",
    "readyTimeoutMs": 20000
  },
  "login": {
    "path": "/api/login",
    "bodyTemplate": { "username": "{username}", "password": "{password}" },
    "credentialPath": "token"
  },
  "responses": { "list": "orders", "entity": "order" },
  "identities": [
    { "name": "alice", "username": "alice", "password": "alice123", "role": "user" },
    { "name": "bob", "username": "bob", "password": "bob123", "role": "user" },
    { "name": "admin", "username": "admin", "password": "admin123", "role": "admin" }
  ],
  "llm": { "enabled": false },
  "scopes": ["project.read", "worktree.write", "proc.spawn", "net.probe"]
}
