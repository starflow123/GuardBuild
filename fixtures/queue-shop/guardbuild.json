{
  "start": {
    "cmd": "node",
    "args": ["server.js"],
    "env": { "PORT": "0" },
    "readyPattern": "listening on port",
    "readyTimeoutMs": 20000
  },
  "login": {
    "path": "/api/login",
    "bodyTemplate": { "email": "{email}", "password": "{password}" },
    "credentialPath": "authentication.token"
  },
  "identities": [
    { "name": "alice", "email": "alice@queue.shop", "password": "alice123", "role": "user" },
    { "name": "bob", "email": "bob@queue.shop", "password": "bob123", "role": "user" },
    { "name": "carol", "email": "carol@queue.shop", "password": "carol123", "role": "admin" }
  ],
  "blackbox": { "maxRoutes": 60 },
  "scopes": ["project.read", "net.probe"]
}
